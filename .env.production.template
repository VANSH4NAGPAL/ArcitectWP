# Production Environment Variables for ArchitectWP Admin Security
# Copy this file to .env.production and fill in the secure values

# ====================
# ADMIN AUTHENTICATION
# ====================

# Admin password hash (use bcrypt with salt rounds 12+)
# Generate with: node -e "const bcrypt=require('bcryptjs'); console.log(bcrypt.hashSync('YourSecurePassword123!', 12))"
ADMIN_PASSWORD_HASH=$2a$12$your-bcrypt-hash-here

# JWT secret for token signing (64+ characters, cryptographically secure)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-secure-64-character-secret-here

# ====================
# RATE LIMITING (Optional)
# ====================

# Redis URL for distributed rate limiting (recommended for production)
# If not set, will use client-side rate limiting only
REDIS_URL=redis://user:password@your-redis-host:6379

# ====================
# AUDIT LOGGING (Optional)
# ====================

# Firebase Project ID for audit log storage
FIREBASE_PROJECT_ID=your-firebase-project-id

# External audit log webhook (e.g., Slack, Discord, DataDog)
AUDIT_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# ====================
# SECURITY HEADERS
# ====================

# Custom security configuration (optional)
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE=31536000

# ====================
# MONITORING (Optional)
# ====================

# Error tracking and monitoring
SENTRY_DSN=https://your-sentry-dsn-here
LOG_LEVEL=production

# ====================
# DEVELOPMENT NOTES
# ====================

# 🚨 SECURITY REQUIREMENTS:
# 1. Use a strong password (12+ chars, mixed case, numbers, symbols)
# 2. Generate JWT_SECRET with crypto.randomBytes(64).toString('hex')
# 3. Set up HTTPS with valid SSL certificate
# 4. Configure Firebase security rules
# 5. Set up monitoring and alerting
# 6. Test all security features thoroughly

# 📝 DEPLOYMENT CHECKLIST:
# □ Generated secure ADMIN_PASSWORD_HASH
# □ Generated secure JWT_SECRET
# □ Set up Redis for rate limiting (optional)
# □ Configured Firebase for audit logs (optional)
# □ Set up HTTPS with SSL certificate
# □ Configured security headers
# □ Tested all admin authentication flows
# □ Set up monitoring and alerting
# □ Documented incident response procedures

